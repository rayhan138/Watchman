#include <winver.h>

// Deliberately different FileVersion and ProductVersion catch the wrong field.
1 VERSIONINFO
 FILEVERSION 9,8,7,6
 PRODUCTVERSION 12,34,56,7
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileVersion", "9.8.7.6\0"
   VALUE "ProductVersion", "12.34.56.7\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
