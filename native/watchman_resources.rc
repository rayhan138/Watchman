#include "resource.h"

IDI_WATCHMAN_APP ICON "watchman_shell.ico"
IDR_WATCHMAN_LOGO RCDATA "assets\\watchman-logo.png"

IDR_FONT_INTER_REGULAR RCDATA "fonts\\Inter-Regular.ttf"
IDR_FONT_INTER_MEDIUM RCDATA "fonts\\Inter-Medium.ttf"
IDR_FONT_INTER_SEMIBOLD RCDATA "fonts\\Inter-SemiBold.ttf"
IDR_FONT_INTER_BOLD RCDATA "fonts\\Inter-Bold.ttf"
IDR_FONT_INTER_EXTRABOLD RCDATA "fonts\\Inter-ExtraBold.ttf"
IDR_FONT_NUNITO_SANS RCDATA "fonts\\NunitoSans-ExtraBold.ttf"
IDR_FONT_JETBRAINS_REGULAR RCDATA "fonts\\JetBrainsMono-Regular.ttf"
IDR_FONT_JETBRAINS_MEDIUM RCDATA "fonts\\JetBrainsMono-Medium.ttf"
IDR_FONT_JETBRAINS_SEMIBOLD RCDATA "fonts\\JetBrainsMono-SemiBold.ttf"
IDR_FONT_JETBRAINS_BOLD RCDATA "fonts\\JetBrainsMono-Bold.ttf"

1 VERSIONINFO
 FILEVERSION WATCHMAN_VERSION_MAJOR, WATCHMAN_VERSION_MINOR, WATCHMAN_VERSION_PATCH, 0
 PRODUCTVERSION WATCHMAN_VERSION_MAJOR, WATCHMAN_VERSION_MINOR, WATCHMAN_VERSION_PATCH, 0
 FILEOS 0x40004L
 FILETYPE 1
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", "Watchman\0"
   VALUE "CompanyName", "Noman Dhoni\0"
   VALUE "FileVersion", WATCHMAN_VERSION_TEXT
   VALUE "ProductVersion", WATCHMAN_VERSION_TEXT
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
